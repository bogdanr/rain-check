,3\"/><polyline class=\"chart-line\" points=\"62.1536,350.4533333333333 131.2072,294.64 215.4938775510204,240.85714285714286 303.86301886792455,217.16981132075472 368.3902127659576,134.17021276595744 410.5343949044587,103.78343949044586\" fill=\"none\" stroke-width=\"2.4\"/><g class=\"pt\" data-tip=\"Forecast said 1%&amp;#10;It rained 9% of the time&amp;#10;Based on 150 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"62.1536\" cy=\"350.4533333333333\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 21%&amp;#10;It rained 24% of the time&amp;#10;Based on 50 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"131.2072\" cy=\"294.64\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 44%&amp;#10;It rained 39% of the time&amp;#10;Based on 49 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"215.4938775510204\" cy=\"240.85714285714286\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 69%&amp;#10;It rained 45% of the time&amp;#10;Based on 53 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"303.86301886792455\" cy=\"217.16981132075472\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 88%&amp;#10;It rained 68% of the time&amp;#10;Based on 47 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"368.3902127659576\" cy=\"134.17021276595744\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 100%&amp;#10;It rained 76% of the time&amp;#10;Based on 157 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"410.5343949044587\" cy=\"103.78343949044586\" r=\"6.5\" stroke-width=\"2\"/></g><text class=\"chart-label\" x=\"235.0\" y=\"422\" font-size=\"12.5\" text-anchor=\"middle\">What the forecast promised</text><text class=\"chart-label\" x=\"15\" y=\"200.0\" font-size=\"12.5\" text-anchor=\"middle\" transform=\"rotate(-90 15 200.0)\">How often it actually rained</text></svg>\n<figcaption>Green band = where a <b>flawless</b> forecast would still land, given\nhow few days we have. Red dots fall outside it, so those are real errors rather\nthan noise. The faint horizontal line is climatology\n(43%).</figcaption></figure>\n","season":"\n<h2 id=\"season\">Does the season matter?</h2>\n<p class=\"muted\">Not enough days in this city's record to split the year into four and still say anything defensible about each part. The split is shown only where it is supported.</p>\n"},"lat":56.946,"lon":24.10589,"n":506,"n_cities":213,"name":"Riga","offset_days":0,"pop_map":[{"hi":0.12,"lo":0.0,"mean":0.011733333333333335,"n":150,"obs":0.08666666666666667,"sig":true},{"hi":0.33,"lo":0.12,"mean":0.20679999999999996,"n":50,"obs":0.24,"sig":false},{"hi":0.59,"lo":0.33,"mean":0.4448979591836735,"n":49,"obs":0.3877551020408163,"sig":false},{"hi":0.82,"lo":0.59,"mean":0.6945283018867926,"n":53,"obs":0.4528301886792453,"sig":true},{"hi":0.96,"lo":0.82,"mean":0.8768085106382982,"n":47,"obs":0.6808510638297872,"sig":true},{"hi":1.0,"lo":0.96,"mean":0.9958598726114651,"n":157,"obs":0.7643312101910829,"sig":true}],"prcp_km":8.5,"provisional":false,"rank":146,"rank_hi":173.0,"rank_lo":91.0,"reliability":0.028407807235064503,"resolution":0.07924257605965163,"skill_pct":null,"slug":"riga","station":"","timezone":"Europe/Riga"}