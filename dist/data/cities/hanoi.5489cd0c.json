732394 59.093658536585366,382.0\" opacity=\"0.16\"/><line class=\"chart-ideal\" x1=\"58\" y1=\"382\" x2=\"412\" y2=\"18\" stroke-dasharray=\"5,4\" stroke-width=\"1.3\"/><line class=\"chart-base\" x1=\"58\" y1=\"237.06382978723403\" x2=\"412\" y2=\"237.06382978723403\" stroke-dasharray=\"2,3\"/><polyline class=\"chart-line\" points=\"59.093658536585366,382.0 92.10366197183097,361.49295774647885 166.7122580645161,340.9032258064516 247.04656716417907,278.77611940298505 314.4593846153846,236.4 369.41588235294125,178.58823529411765 408.389900990099,79.26732673267327\" fill=\"none\" stroke-width=\"2.4\"/><g class=\"pt\" data-tip=\"Forecast said 0%&amp;#10;It rained 0% of the time&amp;#10;Based on 123 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"59.093658536585366\" cy=\"382.0\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 10%&amp;#10;It rained 6% of the time&amp;#10;Based on 71 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"92.10366197183097\" cy=\"361.49295774647885\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 31%&amp;#10;It rained 11% of the time&amp;#10;Based on 62 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"166.7122580645161\" cy=\"340.9032258064516\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 53%&amp;#10;It rained 28% of the time&amp;#10;Based on 67 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"247.04656716417907\" cy=\"278.77611940298505\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 72%&amp;#10;It rained 40% of the time&amp;#10;Based on 65 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"314.4593846153846\" cy=\"236.4\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 88%&amp;#10;It rained 56% of the time&amp;#10;Based on 68 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"369.41588235294125\" cy=\"178.58823529411765\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 99%&amp;#10;It rained 83% of the time&amp;#10;Based on 202 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"408.389900990099\" cy=\"79.26732673267327\" r=\"6.5\" stroke-width=\"2\"/></g><text class=\"chart-label\" x=\"235.0\" y=\"422\" font-size=\"12.5\" text-anchor=\"middle\">What the forecast promised</text><text class=\"chart-label\" x=\"15\" y=\"200.0\" font-size=\"12.5\" text-anchor=\"middle\" transform=\"rotate(-90 15 200.0)\">How often it actually rained</text></svg>\n<figcaption>Green band = where a <b>flawless</b> forecast would still land, given\nhow few days we have. Red dots fall outside it, so those are real errors rather\nthan noise. The faint horizontal line is climatology\n(40%).</figcaption></figure>\n","season":"\n<h2 id=\"season\">Does the season matter?</h2>\n<p>In Hanoi the forecast is most skilful in\n<b>autumn</b> (0.47) and least in\n<b>winter</b> (-0.08).</p>\n<div class=\"tablewrap\">\n<table><thead><tr><th>Season</th><th class=\"num\">Days</th>\n<th class=\"num\">Rain days</th><th class=\"num\">Skill score</th>\n<th class=\"num\">Avg error</th></tr></thead><tbody><tr><td>winter</td><td class='num'>161</td><td class='num'>17%</td><td class='num'>-0.082</td><td class='num'>19.2%</td></tr><tr><td>summer</td><td class='num'>178</td><td class='num'>62%</td><td class='num'>0.131</td><td class='num'>17.3%</td></tr><tr><td>spring</td><td class='num'>141</td><td class='num'>41%</td><td class='num'>0.269</td><td class='num'>18.7%</td></tr><tr><td>autumn</td><td class='num'>178</td><td class='num'>37%</td><td class='num'>0.466</td><td class='num'>12.0%</td></tr></tbody></table>\n</div>\n<p class=\"muted\">Four-way splits of a two-year record are thin, so read the\nordering as indicative. Coarser binning is used here than for the annual curve\nfor the same reason.</p>\n"},"lat":21.0245,"lon":105.84117,"n":658,"n_cities":213,"name":"Hanoi","offset_days":0,"pop_map":[{"hi":0.04,"lo":0.0,"mean":0.0030894308943089435,"n":123,"obs":0.0,"sig":false},{"hi":0.2,"lo":0.04,"mean":0.09633802816901406,"n":71,"obs":0.056338028169014086,"sig":false},{"hi":0.45,"lo":0.2,"mean":0.3070967741935483,"n":62,"obs":0.11290322580645161,"sig":true},{"hi":0.63,"lo":0.45,"mean":0.5340298507462685,"n":67,"obs":0.2835820895522388,"sig":true},{"hi":0.82,"lo":0.63,"mean":0.7244615384615384,"n":65,"obs":0.4,"sig":true},{"hi":0.94,"lo":0.82,"mean":0.8797058823529413,"n":68,"obs":0.5588235294117647,"sig":true},{"hi":1.0,"lo":0.94,"mean":0.9898019801980198,"n":202,"obs":0.8316831683168316,"sig":true}],"prcp_km":10.1,"provisional":false,"rank":93,"rank_hi":147.0,"rank_lo":52.0,"reliability":0.03883015103035223,"resolution":0.11161035310006157,"skill_pct":null,"slug":"hanoi","station":"","timezone":"Asia/Bangkok"}