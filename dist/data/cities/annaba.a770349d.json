1.3\"/><line class=\"chart-base\" x1=\"58\" y1=\"215.36194563662374\" x2=\"412\" y2=\"215.36194563662374\" stroke-dasharray=\"2,3\"/><polyline class=\"chart-line\" points=\"59.64578947368421,273.43859649122805 84.80285714285715,301.6363636363636 137.43545454545455,222.06060606060606 216.10405405405407,145.89189189189187 340.66363636363633,89.69696969696969 408.17297297297307,32.75675675675677\" fill=\"none\" stroke-width=\"2.4\"/><g class=\"pt\" data-tip=\"Forecast said 0%&amp;#10;It rained 30% of the time&amp;#10;Based on 342 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"59.64578947368421\" cy=\"273.43859649122805\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 8%&amp;#10;It rained 22% of the time&amp;#10;Based on 77 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"84.80285714285715\" cy=\"301.6363636363636\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 22%&amp;#10;It rained 44% of the time&amp;#10;Based on 66 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"137.43545454545455\" cy=\"222.06060606060606\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 45%&amp;#10;It rained 65% of the time&amp;#10;Based on 74 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"216.10405405405407\" cy=\"145.89189189189187\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 80%&amp;#10;It rained 80% of the time&amp;#10;Based on 66 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"340.66363636363633\" cy=\"89.69696969696969\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 99%&amp;#10;It rained 96% of the time&amp;#10;Based on 74 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"408.17297297297307\" cy=\"32.75675675675677\" r=\"6.5\" stroke-width=\"2\"/></g><text class=\"chart-label\" x=\"235.0\" y=\"422\" font-size=\"12.5\" text-anchor=\"middle\">What the forecast promised</text><text class=\"chart-label\" x=\"15\" y=\"200.0\" font-size=\"12.5\" text-anchor=\"middle\" transform=\"rotate(-90 15 200.0)\">How often it actually rained</text></svg>\n<figcaption>Green band = where a <b>flawless</b> forecast would still land, given\nhow few days we have. Red dots fall outside it, so those are real errors rather\nthan noise. The faint horizontal line is climatology\n(46%).</figcaption></figure>\n","season":"\n<h2 id=\"season\">Does the season matter?</h2>\n<p>In Annaba the forecast is most skilful in\n<b>autumn</b> (0.05) and least in\n<b>winter</b> (-0.54).</p>\n<div class=\"tablewrap\">\n<table><thead><tr><th>Season</th><th class=\"num\">Days</th>\n<th class=\"num\">Rain days</th><th class=\"num\">Skill score</th>\n<th class=\"num\">Avg error</th></tr></thead><tbody><tr><td>winter</td><td class='num'>174</td><td class='num'>71%</td><td class='num'>-0.544</td><td class='num'>31.6%</td></tr><tr><td>spring</td><td class='num'>197</td><td class='num'>49%</td><td class='num'>-0.072</td><td class='num'>22.4%</td></tr><tr><td>summer</td><td class='num'>179</td><td class='num'>16%</td><td class='num'>-0.062</td><td class='num'>10.4%</td></tr><tr><td>autumn</td><td class='num'>149</td><td class='num'>48%</td><td class='num'>0.047</td><td class='num'>18.6%</td></tr></tbody></table>\n</div>\n<p class=\"muted\">Four-way splits of a two-year record are thin, so read the\nordering as indicative. Coarser binning is used here than for the annual curve\nfor the same reason.</p>\n"},"lat":36.9,"lon":7.76667,"n":699,"n_cities":134,"name":"Annaba","offset_days":0,"pop_map":[{"hi":0.05,"lo":0.0,"mean":0.004649122807017543,"n":342,"obs":0.2982456140350877,"sig":true},{"hi":0.14600000000000135,"lo":0.05,"mean":0.07