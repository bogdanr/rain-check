47825 120.15311475409835,358.1311475409836 224.16545454545454,271.6969696969697 367.86419354838705,158.90322580645162\" fill=\"none\" stroke-width=\"2.4\"/><g class=\"pt\" data-tip=\"Forecast said 0%&amp;#10;It rained 1% of the time&amp;#10;Based on 361 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"59.206149584487534\" cy=\"378.97506925207756\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 7%&amp;#10;It rained 4% of the time&amp;#10;Based on 69 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"83.24173913043478\" cy=\"366.17391304347825\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 18%&amp;#10;It rained 7% of the time&amp;#10;Based on 61 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"120.15311475409835\" cy=\"358.1311475409836\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 47%&amp;#10;It rained 30% of the time&amp;#10;Based on 66 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"224.16545454545454\" cy=\"271.6969696969697\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 88%&amp;#10;It rained 61% of the time&amp;#10;Based on 62 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"367.86419354838705\" cy=\"158.90322580645162\" r=\"6.5\" stroke-width=\"2\"/></g><text class=\"chart-label\" x=\"235.0\" y=\"422\" font-size=\"12.5\" text-anchor=\"middle\">What the forecast promised</text><text class=\"chart-label\" x=\"15\" y=\"200.0\" font-size=\"12.5\" text-anchor=\"middle\" transform=\"rotate(-90 15 200.0)\">How often it actually rained</text></svg>\n<figcaption>Green band = where a <b>flawless</b> forecast would still land, given\nhow few days we have. Red dots fall outside it, so those are real errors rather\nthan noise. The faint horizontal line is climatology\n(11%).</figcaption></figure>\n","season":"\n<h2 id=\"season\">Does the season matter?</h2>\n<p>In Tehran the forecast is most skilful in\n<b>autumn</b> (0.44) and least in\n<b>summer</b> (-0.37).</p>\n<div class=\"tablewrap\">\n<table><thead><tr><th>Season</th><th class=\"num\">Days</th>\n<th class=\"num\">Rain days</th><th class=\"num\">Skill score</th>\n<th class=\"num\">Avg error</th></tr></thead><tbody><tr><td>summer</td><td class='num'>163</td><td class='num'>2%</td><td class='num'>-0.371</td><td class='num'>4.5%</td></tr><tr><td>winter</td><td class='num'>156</td><td class='num'>17%</td><td class='num'>0.113</td><td class='num'>11.7%</td></tr><tr><td>spring</td><td class='num'>128</td><td class='num'>19%</td><td class='num'>0.339</td><td class='num'>5.9%</td></tr><tr><td>autumn</td><td class='num'>172</td><td class='num'>9%</td><td class='num'>0.435</td><td class='num'>2.4%</td></tr></tbody></table>\n</div>\n<p class=\"muted\">Four-way splits of a two-year record are thin, so read the\nordering as indicative. Coarser binning is used here than for the annual curve\nfor the same reason.</p>\n"},"lat":35.69439,"lon":51.42151,"n":619,"n_cities":213,"name":"Tehran","offset_days":0,"pop_map":[{"hi":0.05,"lo":0.0,"mean":0.0034072022160664818,"n":361,"obs":0.008310249307479225,"sig":false},{"hi":0.13,"lo":0.05,"mean":0.07130434782608694,"n":69,"obs":0.043478260869565216,"sig":false},{"hi":0.28,"lo":0.13,"mean":0.17557377049180325,"n":61,"obs":0.06557377049180328,"sig":true},{"hi":0.6560000000000014,"lo":0.28,"mean":0.46939393939393936,"n":66,"obs":0.30303030303030304,"sig":true},{"hi":1.0,"lo":0.6560000000000014,"mean":0.8753225806451612,"n":62,"obs":0.6129032258064516,"sig":true}],"prcp_km":9.8,"provisional":false,"rank":116,"rank_hi":167.02499999999998,"rank_lo":48.925000000000004,"reliability":0.011141260275939986,"resolution":0.03602338637823522,"skill_pct":null,"slug":"tehran","station"