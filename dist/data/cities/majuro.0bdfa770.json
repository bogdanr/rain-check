363637 258.2491891891892,214.75675675675674 144.17105263157896,324.5263157894737\" opacity=\"0.16\"/><line class=\"chart-ideal\" x1=\"58\" y1=\"382\" x2=\"412\" y2=\"18\" stroke-dasharray=\"5,4\" stroke-width=\"1.3\"/><line class=\"chart-base\" x1=\"58\" y1=\"125.2842105263158\" x2=\"412\" y2=\"125.2842105263158\" stroke-dasharray=\"2,3\"/><polyline class=\"chart-line\" points=\"144.17105263157896,329.3157894736842 258.2491891891892,259.02702702702703 317.15558441558437,159.8181818181818 356.4174025974026,164.54545454545456 380.8944262295082,83.63934426229508 396.2135135135135,62.27027027027026 411.27214953271033,50.88473520249221\" fill=\"none\" stroke-width=\"2.4\"/><g class=\"pt\" data-tip=\"Forecast said 24%&amp;#10;It rained 14% of the time&amp;#10;Based on 76 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"144.17105263157896\" cy=\"329.3157894736842\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 57%&amp;#10;It rained 34% of the time&amp;#10;Based on 74 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"258.2491891891892\" cy=\"259.02702702702703\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 73%&amp;#10;It rained 61% of the time&amp;#10;Based on 77 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"317.15558441558437\" cy=\"159.8181818181818\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 84%&amp;#10;It rained 60% of the time&amp;#10;Based on 77 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"356.4174025974026\" cy=\"164.54545454545456\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 91%&amp;#10;It rained 82% of the time&amp;#10;Based on 61 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"380.8944262295082\" cy=\"83.63934426229508\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 96%&amp;#10;It rained 88% of the time&amp;#10;Based on 74 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"396.2135135135135\" cy=\"62.27027027027026\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 100%&amp;#10;It rained 91% of the time&amp;#10;Based on 321 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"411.27214953271033\" cy=\"50.88473520249221\" r=\"6.5\" stroke-width=\"2\"/></g><text class=\"chart-label\" x=\"235.0\" y=\"422\" font-size=\"12.5\" text-anchor=\"middle\">What the forecast promised</text><text class=\"chart-label\" x=\"15\" y=\"200.0\" font-size=\"12.5\" text-anchor=\"middle\" transform=\"rotate(-90 15 200.0)\">How often it actually rained</text></svg>\n<figcaption>Green band = where a <b>flawless</b> forecast would still land, given\nhow few days we have. Red dots fall outside it, so those are real errors rather\nthan noise. The faint horizontal line is climatology\n(71%).</figcaption></figure>\n","season":"\n<h2 id=\"season\">Does the season matter?</h2>\n<p>In Majuro the forecast is most skilful in\n<b>winter</b> (0.36) and least in\n<b>spring</b> (0.15).</p>\n<div class=\"tablewrap\">\n<table><thead><tr><th>Season</th><th class=\"num\">Days</th>\n<th class=\"num\">Rain days</th><th class=\"num\">Skill score</th>\n<th class=\"num\">Avg error</th></tr></thead><tbody><tr><td>spring</td><td class='num'>220</td><td class='num'>70%</td><td class='num'>0.151</td><td class='num'>10.7%</td></tr><tr><td>summer</td><td class='num'>184</td><td class='num'>71%</td><td class='num'>0.196</td><td class='num'>16.2%</td></tr><tr><td>autumn</td><td class='num'>182</td><td class='num'>81%</td><td class='num'>0.218</td><td class='num'>9.8%</td></tr><tr><td>winter</td><td class='num'>174</td><td class='num'>60%</td><td class='num'>0.363</td><td class='num'>12.1%</td></tr></tbody></table>\n</div>\n<p class=\"muted\">Four-way splits of a two-year record are thin, so read the\nordering as indicative. Coarser binning is used here than for the annual curve\nfor the same reason.</p>\n"},"lat":7.08971,"lon":171.38027,"n":760,"n_cities":213,"name":"Majuro","offset_days":0,"pop_map":[{"hi":0.42900000000000005,"lo":0.0,"mean":0.24342105263157898,"n":76,"obs":0.14473684210526316,"sig":true},{"hi":0.67,"lo":0.42900000000000005,"mean":0.5656756756756757,"n":74,"obs":0.33783783783783783,"sig":true},{"hi":0.8,"lo":0.67,"mean":0.732077922077922,"n":77,"obs":0.6103896103896104,"sig":true},{"hi":0.8960000000000002,"lo":0.8,"mean":0.842987012987013,"n":77,"obs":0.5974025974025974,"sig":true},{"hi":0.94,"lo":0.8960000000000002,"mean":0.9121311475409837,"n":61,"obs":0.819672131147541,"sig":true},{"hi":0.98,"lo":0.94,"mean":0.9554054054054053,"n":74,"obs":0.8783783783783784,"sig":true},{"hi":1.0,"lo":0.98,"mean":0.997943925233645,"n":321,"obs":0.9096573208722741,"sig":true}],"prcp_km":12.3,"provisional":false,"rank":132,"rank_hi":156.02499999999998,"rank_lo":85.975,"reliability":0.0181950836555637,"resolution":0.06826837972767336,"skill_pct":null,"slug":"majuro","station":"MAJURO WBAS AP","timezone":"Pacific/Majuro"}