7457627117 405.94328125,18.0 405.94328125,32.21875 369.64000000000004,92.03389830508473 332.114,139.33333333333334 283.8147368421053,196.80701754385964 225.61363636363637,249.63636363636363 161.62545454545455,315.8181818181818 107.7259375,359.25 61.034285714285716,382.0\" opacity=\"0.16\"/><line class=\"chart-ideal\" x1=\"58\" y1=\"382\" x2=\"412\" y2=\"18\" stroke-dasharray=\"5,4\" stroke-width=\"1.3\"/><line class=\"chart-base\" x1=\"58\" y1=\"267.6513157894737\" x2=\"412\" y2=\"267.6513157894737\" stroke-dasharray=\"2,3\"/><polyline class=\"chart-line\" points=\"61.034285714285716,375.88235294117646 107.7259375,359.25 161.62545454545455,329.05454545454546 225.61363636363637,310.3030303030303 283.8147368421053,254.28070175438597 332.114,212.13333333333333 369.64000000000004,203.08474576271186 405.94328125,134.59375\" fill=\"none\" stroke-width=\"2.4\"/><g class=\"pt\" data-tip=\"Forecast said 1%&amp;#10;It rained 2% of the time&amp;#10;Based on 119 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"61.034285714285716\" cy=\"375.88235294117646\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 14%&amp;#10;It rained 6% of the time&amp;#10;Based on 64 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"107.7259375\" cy=\"359.25\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 29%&amp;#10;It rained 15% of the time&amp;#10;Based on 55 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"161.62545454545455\" cy=\"329.05454545454546\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 47%&amp;#10;It rained 20% of the time&amp;#10;Based on 66 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"225.61363636363637\" cy=\"310.3030303030303\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 64%&amp;#10;It rained 35% of the time&amp;#10;Based on 57 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"283.8147368421053\" cy=\"254.28070175438597\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 77%&amp;#10;It rained 47% of the time&amp;#10;Based on 60 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"332.114\" cy=\"212.13333333333333\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 88%&amp;#10;It rained 49% of the time&amp;#10;Based on 59 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"369.64000000000004\" cy=\"203.08474576271186\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 98%&amp;#10;It rained 68% of the time&amp;#10;Based on 128 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"405.94328125\" cy=\"134.59375\" r=\"6.5\" stroke-width=\"2\"/></g><text class=\"chart-label\" x=\"235.0\" y=\"422\" font-size=\"12.5\" text-anchor=\"middle\">What the forecast promised</text><text class=\"chart-label\" x=\"15\" y=\"200.0\" font-size=\"12.5\" text-anchor=\"middle\" transform=\"rotate(-90 15 200.0)\">How often it actually rained</text></svg>\n<figcaption>Green band = where a <b>flawless</b> forecast would still land, given\nhow few days we have. Red dots fall outside it, so those are real errors rather\nthan noise. The faint horizontal line is climatology\n(31%).</figcaption></figure>\n","season":"\n<h2 id=\"season\">Does the season matter?</h2>\n<p>In Kinshasa the forecast is most skilful in\n<b>autumn</b> (-0.09) and least in\n<b>summer</b> (-0.21).</p>\n<div class=\"tablewrap\">\n<table><thead><tr><th>Season</th><th class=\"num\">Days</th>\n<th class=\"num\">Rain days</th><th class=\"num\">Skill score</th>\n<th class=\"num\">Avg error</th></tr></thead><tbody><tr><td>summer</td><td class='num'>155</td><td class='num'>3%</td><td class='num'>-0.205</td><td class='num'>7.3%</td></tr><tr><td>winter</td><td class='num'>167</td><td class='num'>41%</td><td class='num'>-0.191</td><td class='num'>28.1%</td></tr><tr><td>spring</td><td class='num'>129</td><td class='num'>48%</td><td class='num'>-0.143</td><td class='num'>23.5%</td></tr><tr><td>autumn</td><td class='num'>157</td><td class='num'>36%</td><td class='num'>-0.087</td><td class='num'>26.6%</td></tr></tbody></table>\n</div>\n<p class=\"muted\">Four-way splits of a two-year record are thin, so read the\nordering as indicative. Coarser binning is used here than for the annual curve\nfor the same reason.</p>\n"},"lat":-4.32758,"lon":15.31357,"n":608,"n_cities":213,"name":"Kinshasa","offset_days":0,"pop_map":[{"hi":0.06,"lo":0.0,"mean":0.008571428571428574,"n":119,"obs":0.01680672268907563,"sig":false},{"hi":0.22200000000000045,"lo":0.06,"mean":0.14046875,"n":64,"obs":0.0625,"sig":false},{"hi":0.39,"lo":0.22200000000000045,"mean":0.29272727272727267,"n":55,"obs":0.14545454545454545,"sig":true},{"hi":0.56,"lo":0.39,"mean":0.4734848484848485,"n":66,"obs":0.19696969696969696,"sig":true},{"hi":0.73,"lo":0.56,"mean":0.6378947368421053,"n":57,"obs":0.3508771929824561,"sig":true},{"hi":0.84,"lo":0.73,"mean":0.7743333333333332,"n":60,"obs":0.4666666666666667,"sig":true},{"hi":0.94,"lo":0.84,"mean":0.8803389830508476,"n":59,"obs":0.4915254237288136,"sig":true},{"hi":1.0,"lo":0.94,"mean":0.982890625,"n":128,"obs":0.6796875,"sig":true}],"prcp_km":10.8,"provisional":false,"rank":187,"rank_hi":199.0,"rank_lo":159.95,"reliability":0.062003742225499814,"resolution":0.061640578038206995,"skill_pct":null,"slug":"kinshasa","station":"","timezone":"Africa/Kinshasa"}