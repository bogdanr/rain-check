"412\" y2=\"223.0197628458498\" stroke-dasharray=\"2,3\"/><polyline class=\"chart-line\" points=\"61.87714285714286,337.42857142857144 133.82036363636365,256.25454545454545 219.9730612244898,240.85714285714286 298.1753846153846,186.0 365.98,196.1276595744681 410.4342307692308,118.33333333333331\" fill=\"none\" stroke-width=\"2.4\"/><g class=\"pt\" data-tip=\"Forecast said 1%&amp;#10;It rained 12% of the time&amp;#10;Based on 147 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"61.87714285714286\" cy=\"337.42857142857144\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 21%&amp;#10;It rained 35% of the time&amp;#10;Based on 55 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"133.82036363636365\" cy=\"256.25454545454545\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 46%&amp;#10;It rained 39% of the time&amp;#10;Based on 49 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"219.9730612244898\" cy=\"240.85714285714286\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 68%&amp;#10;It rained 54% of the time&amp;#10;Based on 52 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"298.1753846153846\" cy=\"186.0\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 87%&amp;#10;It rained 51% of the time&amp;#10;Based on 47 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"365.98\" cy=\"196.1276595744681\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 100%&amp;#10;It rained 72% of the time&amp;#10;Based on 156 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"410.4342307692308\" cy=\"118.33333333333331\" r=\"6.5\" stroke-width=\"2\"/></g><text class=\"chart-label\" x=\"235.0\" y=\"422\" font-size=\"12.5\" text-anchor=\"middle\">What the forecast promised</text><text class=\"chart-label\" x=\"15\" y=\"200.0\" font-size=\"12.5\" text-anchor=\"middle\" transform=\"rotate(-90 15 200.0)\">How often it actually rained</text></svg>\n<figcaption>Green band = where a <b>flawless</b> forecast would still land, given\nhow few days we have. Red dots fall outside it, so those are real errors rather\nthan noise. The faint horizontal line is climatology\n(44%).</figcaption></figure>\n","season":"\n<h2 id=\"season\">Does the season matter?</h2>\n<p class=\"muted\">Not enough days in this city's record to split the year into four and still say anything defensible about each part. The split is shown only where it is supported.</p>\n"},"lat":56.946,"lon":24.10589,"n":506,"n_cities":134,"name":"Riga","offset_days":1,"pop_map":[{"hi":0.12,"lo":0.0,"mean":0.010952380952380953,"n":147,"obs":0.12244897959183673,"sig":true},{"hi":0.35,"lo":0.12,"mean":0.2141818181818182,"n":55,"obs":0.34545454545454546,"sig":true},{"hi":0.59,"lo":0.35,"mean":0.4575510204081633,"n":49,"obs":0.3877551020408163,"sig":false},{"hi":0.8,"lo":0.59,"mean":0.6784615384615383,"n":52,"obs":0.5384615384615384,"sig":true},{"hi":0.96,"lo":0.8,"mean":0.87,"n":47,"obs":0.5106382978723404,"sig":true},{"hi":1.0,"lo":0.96,"mean":0.9955769230769231,"n":156,"obs":0.7243589743589743,"sig":true}],"prcp_km":8.5,"provisional":false,"rank":121,"rank_hi":129.0,"rank_lo":110.0,"reliability":0.04264421134904879,"resolution":0.05690939891001684,"skill_pct":null,"slug":"riga","station":"","timezone":"Europe/Riga"}