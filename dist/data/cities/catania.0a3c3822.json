ne\" points=\"58.05596837944664,379.12252964426875 71.9009756097561,359.8048780487805 97.36724137931034,344.3448275862069 172.30981818181814,216.54545454545456 275.3063157894736,203.19298245614036 393.9273684210526,56.31578947368422\" fill=\"none\" stroke-width=\"2.4\"/><g class=\"pt\" data-tip=\"Forecast said 0%&amp;#10;It rained 1% of the time&amp;#10;Based on 253 days&amp;#10;outside the perfect-forecast range - real miscalibration\"><circle class=\"chart-dot sig\" cx=\"58.05596837944664\" cy=\"379.12252964426875\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 4%&amp;#10;It rained 6% of the time&amp;#10;Based on 82 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"71.9009756097561\" cy=\"359.8048780487805\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 11%&amp;#10;It rained 10% of the time&amp;#10;Based on 58 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"97.36724137931034\" cy=\"344.3448275862069\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 32%&amp;#10;It rained 45% of the time&amp;#10;Based on 55 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"172.30981818181814\" cy=\"216.54545454545456\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 61%&amp;#10;It rained 49% of the time&amp;#10;Based on 57 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"275.3063157894736\" cy=\"203.19298245614036\" r=\"6.5\" stroke-width=\"2\"/></g><g class=\"pt\" data-tip=\"Forecast said 95%&amp;#10;It rained 89% of the time&amp;#10;Based on 57 days&amp;#10;within the range a perfect forecast would give\"><circle class=\"chart-dot\" cx=\"393.9273684210526\" cy=\"56.31578947368422\" r=\"6.5\" stroke-width=\"2\"/></g><text class=\"chart-label\" x=\"235.0\" y=\"422\" font-size=\"12.5\" text-anchor=\"middle\">What the forecast promised</text><text class=\"chart-label\" x=\"15\" y=\"200.0\" font-size=\"12.5\" text-anchor=\"middle\" transform=\"rotate(-90 15 200.0)\">How often it actually rained</text></svg>\n<figcaption>Green band = where a <b>flawless</b> forecast would still land, given\nhow few days we have. Red dots fall outside it, so those are real errors rather\nthan noise. The faint horizontal line is climatology\n(21%).</figcaption></figure>\n","season":"\n<h2 id=\"season\">Does the season matter?</h2>\n<p class=\"muted\">Not enough days in this city's record to split the year into four and still say anything defensible about each part. The split is shown only where it is supported.</p>\n"},"lat":37.49223,"lon":15.07041,"n":562,"n_cities":134,"name":"Catania","offset_days":0,"pop_map":[{"hi":0.03,"lo":0.0,"mean":0.00015810276679841898,"n":253,"obs":0.007905138339920948,"sig":true},{"hi":0.08,"lo":0.03,"mean":0.03926829268292683,"n":82,"obs":0.06097560975609756,"sig":false},{"hi":0.19400000000000092,"lo":0.08,"mean":0.11120689655172412,"n":58,"obs":0.10344827586206896,"sig":false},{"hi":0.48,"lo":0.19400000000000092,"mean":0.3229090909090908,"n":55,"obs":0.45454545454545453,"sig":false},{"hi":0.827000000000001,"lo":0.48,"mean":0.6138596491228069,"n":57,"obs":0.49122807017543857,"sig":false},{"hi":1.0,"lo":0.827000000000001,"mean":0.9489473684210525,"n":57,"obs":0.8947368421052632,"sig":false}],"prcp_km":17.0,"provisional":false,"rank":15,"rank_hi":40.02499999999998,"rank_lo":5.0,"reliability":0.0036211158884503123,"resolution":0.08422300357828863,"skill_pct":null,"slug":"catania","station":"SIGONELLA","timezone":"Europe/Rome"}